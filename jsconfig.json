{
    "compilerOptions": {
        "module": "ESNext",
        "ignoreDeprecations": "6.0",
        "moduleResolution": "Node",
        "target": "ES2024",
        "jsx": "react-jsx",
        "checkJs": true,
        "experimentalDecorators": false,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strict": true,
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}